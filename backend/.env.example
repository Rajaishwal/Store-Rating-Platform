# Copy to .env and fill in real values.

NODE_ENV=development
PORT=4000

# MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/store_rating_db"

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Origin allowed to call this API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

BCRYPT_ROUNDS=10
